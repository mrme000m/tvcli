# services: guacd + postgres + guacamole (clientless gateway on :8080/guacamole)
# Grounded on official images pinned to {{ guacamole_version }}.

networks:
  guacnetwork_compose:
    driver: bridge

services:
  guacd:
    container_name: guacd_compose
    image: guacamole/guacd:{{ guacamole_version }}
    networks:
      - guacnetwork_compose
    restart: always
    volumes:
      - ./drive:/drive:rw
      - ./record:/record:rw

  postgres:
    container_name: postgres_guacamole_compose
    environment:
      PGDATA: /var/lib/postgresql/data/guacamole
      POSTGRES_DB: {{ guacamole_postgres_db }}
      POSTGRES_PASSWORD: {{ guacamole_postgres_password }}
      POSTGRES_USER: {{ guacamole_postgres_user }}
    image: {{ guacamole_postgres_image }}
    networks:
      - guacnetwork_compose
    restart: always
    volumes:
      - ./init:/docker-entrypoint-initdb.d:z
      - ./data:/var/lib/postgresql/data:Z

  guacamole:
    container_name: guacamole_compose
    depends_on:
      - guacd
      - postgres
    environment:
      GUACD_HOSTNAME: guacd
      POSTGRESQL_DATABASE: {{ guacamole_postgres_db }}
      POSTGRESQL_HOSTNAME: postgres
      POSTGRESQL_PASSWORD: {{ guacamole_postgres_password }}
      POSTGRESQL_USERNAME: {{ guacamole_postgres_user }}
      RECORDING_SEARCH_PATH: /record
    image: guacamole/guacamole:{{ guacamole_version }}
    networks:
      - guacnetwork_compose
    volumes:
      - ./record:/record:rw
    ports:
      - "{{ guacamole_http_port }}:8080/tcp"   # Guacamole UI is on :8080/guacamole
    restart: always