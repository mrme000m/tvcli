# ═══════════════════════════════════════════════════════════════════════════
# grid-autonomy — container environment template
#
# Copy to docker/grid.env and edit, then lock it down:
#   cp env.example grid.env && chmod 600 grid.env
#
# grid.env holds SECRETS — never commit it, never bake these values into the
# Docker image. File-bound secrets (TradingView auth, WT cookies) are separate
# bind-mounted files (.env / wt-session.env) — see docker/README.md §d.
#
# Legend: [req-live]  required before GRID_MODE=live-paper (recommended in
#                     dry-run too — the swarm degrades to rule fallback
#                     without LLM keys, it does not crash)
#         [opt]       optional / has a safe default
# ═══════════════════════════════════════════════════════════════════════════

# ── Bitwarden vault (RECOMMENDED: fully automated secrets) ──────────────────
# When all four BW_* values below are set, the entrypoint runs
# docker/vault_loader.sh at boot: it machine-authenticates against the
# self-hosted vault (BW_URL), and materializes:
#   wundertrading         (folder grid-autonomy) → WT_EMAIL/WT_PASSWORD
#   provider-keys         (fields)  → NVIDIA_API_KEY, OPENROUTER_API_KEY,
#                                     MISTRAL_VIBE_API_KEY → MISTRAL_API_KEY
#   opencode-cloudflare   (notes)   → CLOUDFLARE_ACCOUNT_ID/API_KEY
#   tvcli-primary-env     (notes)   → /app/.env (only when NOT bind-mounted)
#   wundertrading-session (notes)   → wt-session.env (only when absent)
# Vault values override grid.env keys set below; MOUNTED FILES always win
# over vault writes (.env / wt-session.env). With WT creds available the
# entrypoint performs AUTOMATIC WunderTrading credential re-login when the
# stored session is stale (wt-login.mjs) plus a periodic session keeper.
# Leave all four empty to run fully from the manual files below.
# NOTE: these values are also available as GitHub repo secrets of
# mrme000m/tvcli (used by the grid-autonomy-vault-smoke CI workflow).

# [opt] Vault server URL (self-hosted Vaultwarden). Empty = vault disabled.
BW_URL=
# [opt] Display-only label for the vault account (not used by the loader).
BW_USERNAME=
# [opt] Machine-auth API key client id (format user.<uuid>) — required with
# BW_URL. Generated in the vault web UI: Settings → API key.
BW_CLIENTID=
# [opt] Machine-auth API key client secret — required with BW_URL.
BW_CLIENTSECRET=
# [opt] Vault MASTER PASSWORD (unlocks the vault after API-key login).
# Required with BW_URL; wrong value aborts the container boot's vault step.
BW_PASSWORD=

# [opt] Interval in seconds for the WT session keeper (background loop that
# probes the WunderTrading session and re-logs-in via wt-login.mjs when it
# goes stale and credentials are available). Default 1800 (30 min).
WT_KEEPER_INTERVAL=1800

# ── Daemon mode & component control ────────────────────────────────────────

# dry-run = planning only (screens, deliberates, journals — creates nothing);
# live-paper = creates REAL bots on WunderTrading PAPER profiles. Both the
# image default and this template ship live-paper — the intended VPS
# production mode. The VPS runs on its OWN WunderTrading account (vault item
# `wundertrading`, folder grid-autonomy — NOT the Mac's local account), so a
# live-paper VPS fleet and the Mac's fleet do not collide. Switch to
# dry-run deliberately if you want plan-only.

# Which in-container components the entrypoint starts, comma-separated.
# Default: xvfb,pb,serve,browser,daemon,console,dsh (the whole stack — dsh
# is the GA agent's web UI on :3081, see the "dsh web (GA agent)" section
# below). Drop an entry to run headless pieces only (rarely needed). NOTE:
# deployments upgrading from an older image keep their OLD GRID_COMPONENTS
# value if it is set in grid.env — add ",dsh" there to get the GA agent.
GRID_COMPONENTS=xvfb,pb,serve,browser,daemon,console,dsh

# 1 = entrypoint exits when required env is missing (strict CI-style boot);
# 0 = warn and continue (image default — the daemon fail-softs per
# dependency anyway).
GRID_STRICT_ENV=0

# ── LLM providers (deliberation swarm + optimizer arbiter) ─────────────────

# [req-live] Cloudflare Workers AI — PRIMARY provider of the LLM chain
# (llm.chain: cf,nvidia,openrouter). Dashboard → Workers AI → account id
# (dash.cloudflare.com, right sidebar) + API token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
# [req-live] Cloudflare API key — use this OR CLOUDFLARE_AI_TOKEN below
# (one of the two is enough). dash.cloudflare.com → My Profile → API Tokens.
CLOUDFLARE_API_KEY=
# [opt] Alternative CF auth token (account-scoped Workers AI token). Wins over
# CLOUDFLARE_API_KEY when set. Same place: CF dashboard → API Tokens.
CLOUDFLARE_AI_TOKEN=

# [opt] NVIDIA NIM fallback provider (chain slot 2). build.nvidia.com →
# API keys. Without it the chain skips straight to OpenRouter.
NVIDIA_API_KEY=

# [opt] OpenRouter fallback provider (chain slot 3). openrouter.ai → Keys.
OPENROUTER_API_KEY=

# [opt] Mistral — the slot optimizer's arbiter is PINNED to mistral
# (optimizer.llm_provider). Without a key the fast-lane swap verdicts degrade
# to the numeric-margin rule fallback (llm_degraded). console.mistral.ai →
# API keys.
MISTRAL_API_KEY=

# ── PocketBase (event-driven persistence side channel, 127.0.0.1:8090) ─────

# [req-live] Superuser email, used once at first boot to create the PB admin
# (the entrypoint runs scripts/setup_pocketbase.sh, Linux-patched). Also
# needed for PB dashboard logins. Any value works; keep it private.
PB_ADMIN_EMAIL=

# [req-live] Superuser password. If left EMPTY, first boot generates one and
# prints it once in `docker compose logs` — but on a headless VPS that is
# easy to miss, so SET it (openssl rand -hex 16).
PB_ADMIN_PASS=

# [opt] Bind host for `pocketbase serve` inside the container. Default
# 127.0.0.1 (recommended — PB stays container-internal). Set 0.0.0.0 ONLY to
# publish the dashboard port (README §f "PocketBase dashboard").
PB_HOST=127.0.0.1

# [opt] Bind port. Default 8090; there is normally no reason to change it.
PB_PORT=8090

# [opt] PocketBase version to pin (downloaded at build/first boot). Default
# 0.40.2. Check github.com/pocketbase/pocketbase/releases before bumping.
PB_VERSION=0.40.2

# ── dsh web — the GA agent (DeepSeek Harness + prime-agent) :3081 ────────────
#
# The image bakes the DSH (deepseek-harness) CLI (@deepseek-ai/dsh@0.1.1-rc.2,
# pnpm 10), the dsh-prime-orchestrator plugin (installed into a baked `web`
# profile under the SEED home /opt/dsh-home), the prime-agent CLI, and the GA
# agent preset (docker/ga-preset/) + the grid-autonomy/grid-bot skill dirs.
# The entrypoint's `dsh` component seeds the writable runtime home
# (DSH_HOME=/data/dsh — the grid-dsh named volume) from the seed home on
# first boot, renders settings.yaml (default preset: ga, Cloudflare Workers
# AI provider) from the runtime CF env, and serves the web UI on :3081.
# The same CLOUDFLARE_* keys as the daemon's LLM chain power the agent —
# nothing extra to configure here (CLOUDFLARE_ACCOUNT_ID +
# CLOUDFLARE_API_KEY/CLOUDFLARE_AI_TOKEN above or via the vault).

# [opt] Port for `dsh web` inside the container + the 127.0.0.1 publish in
# vps-run.sh / docker-compose.yml. Default 3081.
DSH_WEB_PORT=3081

# [opt] Authority the dsh web /api browser-trust fence additionally accepts
# (the fence takes the bind host by default; tunnel requests arrive with
# Host: <this value>). Default: dsh.00m.indevs.in — the CF tunnel hostname
# the deploy workflow's ingress step ensures. Change it if you front :3081
# with a different hostname (host or host:port).
DSH_TRUSTED_HOST=dsh.00m.indevs.in

# ── Browser / display / endpoints ───────────────────────────────────────────

# [opt] CloakBrowser profile directory (the WT cookie session store) —
# matches the grid-browser-profile volume mount in docker-compose.yml.
# Default: /data/browser-profile. Do not change without editing compose.
CB_PROFILE=/data/browser-profile

# [opt] Xvfb display for the headful Chromium (GRID_COMPONENTS xvfb).
# Default :99. Change only if something else inside the container grabs it.
DISPLAY=:99

# [opt] tvcli serve (TradingView confluence backend) base URL. Default
# http://127.0.0.1:8765 — keep it container-internal.
TVCLI_SERVER=http://127.0.0.1:8765

# [opt] Container timezone — stamps logs, run cards, journal entries.
# Default UTC. Use e.g. Europe/Berlin or America/New_York.
TZ=UTC

# ── Network binding ─────────────────────────────────────────────────────────

# [opt] Bind host for the console (:8798) + ctl (:8799) HTTP servers. Image
# default 0.0.0.0 so `docker -p` port publishing works; set 127.0.0.1 to
# restore loopback-only binding inside the container (makes the published
# ports unreachable from the host). The 0.0.0.0 binding is container-scoped —
# host firewall / publish binding still controls exposure (README §g).
GRID_BIND_HOST=0.0.0.0
