# ═══════════════════════════════════════════════════════════════════════════
# grid-ga — the standalone GA-agent container environment template
#
# Copy to docker/ga/ga.env and edit, then lock it down:
#   cp docker/ga/env.example ga.env && chmod 600 ga.env
#
# ga.env holds SECRETS — never commit it, never bake these values into the
# Docker image. This container has NO trading secrets (no WT creds, no
# session cookies): BW_VAULT_ONLY=cf,llm restricts the vault load to the
# Cloudflare items (opencode-cloudflare: CLOUDFLARE_ACCOUNT_ID/
# CLOUDFLARE_API_KEY for the dsh/prime-agent CF Workers AI provider;
# cloudflare-tunnels: CF_ACCOUNT_ID + CF_API_TOKEN_READ/WRITE for the cf
# skill) and the LLM provider keys (provider-keys: NVIDIA_API_KEY,
# OPENROUTER_API_KEY, MISTRAL_API_KEY, NVIDIA_BASE_URL — the worker fallback
# chain; providers whose key is absent are simply skipped). Leave all BW_*
# empty to run fully from inline env.
#
# The deploy workflow (.github/workflows/ga-deploy.yml) writes this file to
# /opt/grid-ga/.env on the host from the SAME repo secrets (BW_URL,
# BW_USERNAME, BW_PASSWORD, BW_CLIENTID, BW_CLIENTSECRET) the grid-autonomy
# deployment uses, plus GH_PUSH_TOKEN.
# ═══════════════════════════════════════════════════════════════════════════

# ── Bitwarden vault (Cloudflare items only — BW_VAULT_ONLY=cf) ─────────────

# [opt] Vault server URL (self-hosted Vaultwarden). Empty = vault disabled.
BW_URL=
# [opt] Display-only label for the vault account (not used by the loader).
BW_USERNAME=
# [opt] Machine-auth API key client id (format user.<uuid>) — required with
# BW_URL. Generated in the vault web UI: Settings → API key.
BW_CLIENTID=
# [opt] Machine-auth API key client secret — required with BW_URL.
BW_CLIENTSECRET=
# [opt] Vault MASTER PASSWORD (unlocks the vault after API-key login).
# Required with BW_URL; wrong value aborts the container boot's vault step.
BW_PASSWORD=

# ── GitHub (the /srv/tvcli workbench) ───────────────────────────────────────

# [req-deploy] PAT with repo (or contents:write) scope for
# github.com/mrme000m/tvcli. ga-run.sh bridges it into the container as
# GH_TOKEN: `gh auth setup-git` wires the git credential helper so the GA
# agent can push code updates from the /srv/tvcli workbench (each push to
# main auto-deploys the grid-autonomy container — the GA persona's push
# guardrail requires explicit human confirmation first). Empty = read-only
# workbench (clone + pull still work — the repo is public).
GH_PUSH_TOKEN=

# ── dsh web (the GA agent web UI) ──────────────────────────────────────────

# [opt] Port for `dsh web` inside the container (host publish is
# 127.0.0.1:3082). Default 3081.
DSH_WEB_PORT=3081

# [opt] Authority the dsh web /api browser-trust fence additionally accepts
# (the fence takes the bind host by default; tunnel requests arrive with
# Host: <this value>). Default: dsh.00m.indevs.in — the CF tunnel hostname
# the deploy workflow's ingress step ensures. Change it if you front the
# container port with a different hostname (host or host:port).
DSH_TRUSTED_HOST=dsh.00m.indevs.in

# ── LLM providers (worker fallback chain — CF stays GA's own model) ──────────
#
# CF Workers AI is GA's default model (cloudflare-workers-ai @cf/zai-org/
# glm-5.3 — user directive, see dsh-settings.yaml). The three providers
# below back the prime-agent worker fallback chain, mirroring the
# grid-autonomy daemon's LLM chain order (CF → Nvidia → OpenRouter, plus
# Mistral for arbiters). They come from the vault's provider-keys item
# (NVIDIA_API_KEY, OPENROUTER_API_KEY, MISTRAL_API_KEY) — set them here
# ONLY for vault-less local runs.

# [opt] NVIDIA NIM fallback provider. build.nvidia.com → API keys.
NVIDIA_API_KEY=
# [opt] NVIDIA base URL override (the vault's NVIDIA_BASE_URL value; default
# https://integrate.api.nvidia.com/v1).
NVIDIA_BASE_URL=
# [opt] OpenRouter fallback provider (free-tier ids). openrouter.ai → Keys.
OPENROUTER_API_KEY=
# [opt] Mistral (arbiters / pin-tolerant tasks). console.mistral.ai → API keys.
MISTRAL_API_KEY=
