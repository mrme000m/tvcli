{
  "name": "dsh-cloak-panel",
  "version": "0.1.0",
  "description": "DSH web plugin: collapsible, resizable right-side panel that streams the headful CloakBrowser while agents reverse-engineer backend APIs (TradingView, WunderTrading, etc.)",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "main": "./lib/index.js",
  "files": ["lib/", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": ["dsh-plugin", "cloakbrowser", "browser-debug", "tradingview", "wundertrading"],
  "license": "MIT"
}
