#!/usr/bin/env bash
# prime-stack — standalone runner for the bootstrap engine (no Ansible needed).
# Usage: bootstrapping/python/bin/prime-stack [--dry-run] <stage|group> ...
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m prime_stack "$@"
