{
  "name": "tvcli",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "DISPLAY": ":99"
  },
  "forwardPorts": [5900, 6080, 8765],
  "portsAttributes": {
    "5900": { "label": "VNC (x11vnc)" },
    "6080": { "label": "noVNC web viewer" },
    "8765": { "label": "tvcli HTTP server (/hunt multi-symbol)" }
  },
  "secrets": {
    "BW_CLIENTID": { "description": "Bitwarden API-key client id (vault: keys.00m.indevs.in)" },
    "BW_CLIENTSECRET": { "description": "Bitwarden API-key client secret" },
    "BW_PASSWORD": { "description": "Bitwarden master password — used non-interactively by browser-debug/secrets/bw-provision.sh" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.Go"],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "go.useLanguageServer": true
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteUser": "vscode"
}