//@version=5
// ScalpQuant v2 — extended consolidated quantitative scalping indicator.
// All outputs are named numeric plot series for programmatic consumption.
indicator("ScalpQuant_v2", overlay=true, max_bars_back=2000, max_labels_count=0, max_lines_count=0, max_boxes_count=0)

// ─────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────
// Bias engine (MTF)
fastLength       = input.int(10,   "Fast MA Len",    minval=1,   group="Bias")
slowLength       = input.int(20,   "Slow MA Len",    minval=1,   group="Bias")
rsiLength        = input.int(14,   "RSI Len",        minval=1,   group="Bias")
macdFastLength   = input.int(12,   "MACD Fast",      minval=1,   group="Bias")
macdSlowLength   = input.int(26,   "MACD Slow",      minval=1,   group="Bias")
macdSignalLength = input.int(9,    "MACD Signal",    minval=1,   group="Bias")
bbLength         = input.int(20,   "BB Len",         minval=1,   group="Bias")
bbMultiplier     = input.float(2.0,"BB Mult",        minval=0.1, group="Bias")
dmiLength        = input.int(14,   "DMI Len",        minval=1,   group="Bias")
dmiSmoothing     = input.int(14,   "DMI Smooth",     minval=1,   group="Bias")
sarStartValue    = input.float(0.02,"SAR Start",     minval=0.01,step=0.01,group="Bias")
sarIncrement     = input.float(0.02,"SAR Inc",       minval=0.01,step=0.01,group="Bias")
sarMaxValue      = input.float(0.2, "SAR Max",       minval=0.1, step=0.1, group="Bias")

// Trend / stop
ema2Len      = input.int(20,    "EMA1 Len",        minval=1,   group="Trend")
ema3Len      = input.int(50,    "EMA2 Len",        minval=1,   group="Trend")
atrLen       = input.int(7,     "ATR Len",         minval=1,   group="Trend")
atrMult      = input.float(1.4, "ATR Mult",        minval=0.1, step=0.1, group="Trend")
atrP1        = input.int(10,    "ST1 ATR",         minval=1,   group="Trend")
mult1        = input.float(1.0, "ST1 Mult",        minval=0.1, step=0.1, group="Trend")
atrP2        = input.int(5,     "ST2 ATR",         minval=1,   group="Trend")
mult2        = input.float(0.5, "ST2 Mult",        minval=0.1, step=0.1, group="Trend")
swATRLen     = input.int(28,    "Swing ATR Len",   minval=1,   group="Trend")
swATRFactor  = input.float(5.0, "Swing ATR Factor",minval=0.5, step=0.1, group="Trend")

// EMA ribbon / sniper
emaFastLen   = input.int(14,    "EMA Fast",        minval=1,   group="EMA")
emaSlowLen   = input.int(21,    "EMA Slow",        minval=1,   group="EMA")
ema200Len    = input.int(200,   "EMA 200",         minval=1,   group="EMA")
tp1Pct       = input.float(1.1, "TP1 %",           minval=0.1, group="EMA")
tp2Pct       = input.float(3.3, "TP2 %",           minval=0.1, group="EMA")
tp3Pct       = input.float(5.5, "TP3 %",           minval=0.1, group="EMA")

// Volume
volMaLen     = input.int(10,    "Buy/Sell Vol MA", minval=1,   group="Volume")
vpLookback   = input.int(200,   "VP Lookback",     minval=20,  maxval=500, group="Volume")
vpBins       = input.int(50,    "VP Bins",         minval=10,  maxval=200, group="Volume")
volMaLenOF   = input.int(20,    "VolSpike MA",     minval=1,   group="Volume")
volMultOF    = input.float(3.0, "VolSpike Mult",   minval=1.0, step=0.1,   group="Volume")
coinMaLen    = input.int(5,     "VolSpike Coin MA",minval=1,   group="Volume")

// Levels
leftB        = input.int(15,    "S/R Left",        minval=1,   group="Levels")
rightB       = input.int(15,    "S/R Right",       minval=1,   group="Levels")

// Oscillator / quality
hmaLength    = input.int(50,    "HMA Len",         minval=1,   group="Quality")
stAtr        = input.int(10,    "Conf ST ATR",     minval=1,   group="Quality")
stFactor     = input.float(3.0, "Conf ST Mult",    minval=0.1, step=0.1, group="Quality")
kernelPeriod = input.int(30,    "Conf Kernel",     minval=1,   group="Quality")
dviVolLen    = input.int(14,    "DVI Vol Len",     minval=1,   group="Quality")
dviMomLen    = input.int(14,    "DVI Mom Len",     minval=1,   group="Quality")
erLen        = input.int(20,    "TQI ER Len",      minval=5,   group="Quality")

// Liquidity
sweepLookback = input.int(20,   "Sweep Lookback",  minval=5,   group="Liquidity")
sweepMult     = input.float(1.5,"Sweep Vol Mult",  minval=1.0, step=0.1, group="Liquidity")

// Ichimoku
ichiConvLen   = input.int(9,    "Ichi Conv",       minval=1,   group="Ichimoku")
ichiBaseLen   = input.int(26,   "Ichi Base",       minval=1,   group="Ichimoku")
ichiSpanLen   = input.int(52,   "Ichi Span B",     minval=1,   group="Ichimoku")

// Order Blocks
obLookback    = input.int(20,   "OB Lookback",     minval=5,   group="Structure")
obStrength    = input.int(3,    "OB Strength",     minval=1,   group="Structure")

// FVG
fvgMinATR     = input.float(0.5,"FVG Min ATR Mult",minval=0.1, step=0.1, group="Structure")

// Regime
regimeLen     = input.int(50,   "Regime Len",      minval=10,  group="Regime")
regimeATRLen  = input.int(14,   "Regime ATR Len",  minval=5,   group="Regime")

// Keltner
keltLen       = input.int(20,   "Keltner Len",     minval=1,   group="Keltner")
keltMult      = input.float(1.5,"Keltner Mult",    minval=0.1, step=0.1, group="Keltner")

// Session (UTC offsets as hours)
asiaStart     = input.int(0,    "Asia Start H",    minval=0, maxval=23, group="Session")
asiaEnd       = input.int(8,    "Asia End H",      minval=0, maxval=23, group="Session")
londonStart   = input.int(7,    "London Start H",  minval=0, maxval=23, group="Session")
londonEnd     = input.int(16,   "London End H",    minval=0, maxval=23, group="Session")
nyStart       = input.int(13,   "NY Start H",      minval=0, maxval=23, group="Session")
nyEnd         = input.int(21,   "NY End H",        minval=0, maxval=23, group="Session")

// Candle patterns
candleLookback = input.int(3,   "Candle Pattern LB",minval=1,  group="Patterns")

// Memory / decay
decayBars      = input.int(10,  "Signal Decay Bars",minval=1,  group="Composite")
compWeightBias = input.float(25.0,"W: Bias",       minval=0, step=1, group="Composite")
compWeightTrend= input.float(10.0,"W: Trend",      minval=0, step=1, group="Composite")
compWeightST   = input.float(10.0,"W: SuperTrend", minval=0, step=1, group="Composite")
compWeightConf = input.float(15.0,"W: Confidence",  minval=0, step=1, group="Composite")
compWeightTQI  = input.float(10.0,"W: TQI",        minval=0, step=1, group="Composite")
compWeightDiv  = input.float(5.0, "W: Divergence", minval=0, step=1, group="Composite")
compWeightLiq  = input.float(5.0, "W: LiqSweep",   minval=0, step=1, group="Composite")
compWeightVol  = input.float(5.0, "W: VolSpike",   minval=0, step=1, group="Composite")
compWeightOB   = input.float(5.0, "W: OrderBlock",  minval=0, step=1, group="Composite")
compWeightFVG  = input.float(5.0, "W: FVG",        minval=0, step=1, group="Composite")
compWeightIchi = input.float(5.0, "W: Ichimoku",   minval=0, step=1, group="Composite")

// ─────────────────────────────────────────────────────────────────────────
// 1) BIAS ENGINE (MTF) — 6-vote trend score per timeframe
// ─────────────────────────────────────────────────────────────────────────
getTrend() =>
    fastMA = ta.sma(close, fastLength)
    slowMA = ta.sma(close, slowLength)
    maUp   = fastMA > slowMA
    rsiUp  = ta.rsi(close, rsiLength) > 50
    [macdLine, signalLine, _] = ta.macd(close, macdFastLength, macdSlowLength, macdSignalLength)
    macdUp = macdLine > signalLine
    [mid, _, _bb] = ta.bb(close, bbLength, bbMultiplier)
    bbUp = close > mid
    [diP, diM, _dmi] = ta.dmi(dmiLength, dmiSmoothing)
    dmiUp = diP > diM
    psarUp = close > ta.sar(sarStartValue, sarIncrement, sarMaxValue)
    strength = (maUp ? 1 : -1) + (rsiUp ? 1 : -1) + (macdUp ? 1 : -1) +
               (bbUp ? 1 : -1) + (dmiUp ? 1 : -1) + (psarUp ? 1 : -1)
    bias = strength >= 2 ? 1 : strength <= -2 ? -1 : 0
    [bias, strength]

[bM15, sM15] = request.security(syminfo.tickerid, "15",  getTrend(), lookahead=barmerge.lookahead_off)
[bM30, sM30] = request.security(syminfo.tickerid, "30",  getTrend(), lookahead=barmerge.lookahead_off)
[bH1,  sH1 ] = request.security(syminfo.tickerid, "60",  getTrend(), lookahead=barmerge.lookahead_off)
[bH4,  sH4 ] = request.security(syminfo.tickerid, "240", getTrend(), lookahead=barmerge.lookahead_off)
[bD1,  sD1 ] = request.security(syminfo.tickerid, "D",   getTrend(), lookahead=barmerge.lookahead_off)

biasWeighted  = (bM15 * 0.5 + bM30 * 1.0 + bH1 * 1.5 + bH4 * 2.0 + bD1 * 3.0) / 8.0
biasStrength  = sM15 + sM30 + sH1 + sH4 + sD1
mtfAlignment  = (bM15 == bM30 and bM30 == bH1 and bH1 == bH4) ? bM15 : 0

plot(bH1,  "biasH1",  display=display.none)
plot(bH4,  "biasH4",  display=display.none)
plot(bD1,  "biasD1",  display=display.none)
plot(biasStrength,  "biasStrength",  display=display.none)
plot(biasWeighted,  "biasWeighted",  display=display.none)
plot(mtfAlignment,  "mtfAlignment",  display=display.none)
plot(close, "price", display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 2) TREND / STOP (ema-atr, ust, swingarm)
// ─────────────────────────────────────────────────────────────────────────
atr     = ta.atr(atrLen)
atr14   = ta.atr(14)
ema2    = ta.ema(close, ema2Len)
ema3    = ta.ema(close, ema3Len)
longStop  = close - atr * atrMult
shortStop = close + atr * atrMult

var float trail  = na
var bool  trendUp = true
if na(trail)
    trail := close
if close > trail
    trendUp := true
    trail   := math.max(trail, longStop)
else
    trendUp := false
    trail   := math.min(trail, shortStop)

emaTrend = (trendUp and close > ema2 and close > ema3) ? 1 :
           (not trendUp and close < ema2 and close < ema3) ? -1 : 0

[supertrend1, dir1] = ta.supertrend(mult1, atrP1)
[supertrend2, dir2] = ta.supertrend(mult2, atrP2)
stTrend  = dir1 == -1 ? 1 : -1
stTrend2 = dir2 == -1 ? 1 : -1
stAgree  = stTrend == stTrend2 ? stTrend : 0

// SwingArm
swLoss = swATRFactor * ta.atr(swATRLen)
var float swUp    = na
var float swDn    = na
var int   swTrend = 1
var float swEx    = na
swUp := na(swUp[1]) ? close - swLoss : (close[1] > swUp[1] ? math.max(close - swLoss, swUp[1]) : close - swLoss)
swDn := na(swDn[1]) ? close + swLoss : (close[1] < swDn[1] ? math.min(close + swLoss, swDn[1]) : close + swLoss)
swTrend := close > swDn[1] ? 1 : close < swUp[1] ? -1 : nz(swTrend[1], 1)
swTrail = swTrend == 1 ? swUp : swDn
swEx := swTrend == 1 ? math.max(nz(swEx[1], high), high) : math.min(nz(swEx[1], low), low)
fib1 = swEx + (swTrail - swEx) * 0.618
fib2 = swEx + (swTrail - swEx) * 0.786
fib3 = swEx + (swTrail - swEx) * 0.886

// Trend duration (bars since trend flip)
var int trendDuration = 0
trendFlip = emaTrend != emaTrend[1] and emaTrend != 0
trendDuration := trendFlip ? 1 : trendDuration + 1

plot(emaTrend,      "emaTrend",      display=display.none)
plot(longStop,      "atrStopLong")
plot(shortStop,     "atrStopShort")
plot(stTrend,       "stTrend",       display=display.none)
plot(atr14,         "atr14",         display=display.none)
plot(trendDuration, "trendDuration", display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 3) EMA RIBBON / SNIPER
// ─────────────────────────────────────────────────────────────────────────
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
ema200v  = ta.ema(close, ema200Len)
crossUp  = ta.crossover(emaFast, emaSlow)
crossDn  = ta.crossunder(emaFast, emaSlow)
emaTrendCross = crossUp ? 1 : crossDn ? -1 : 0

// Dynamic TP/SL based on ATR
dynSL_long  = close - atr14 * 1.5
dynSL_short = close + atr14 * 1.5
dynTP1_long = close + atr14 * 1.0
dynTP2_long = close + atr14 * 2.5
dynTP3_long = close + atr14 * 4.0
dynTP1_short = close - atr14 * 1.0
dynTP2_short = close - atr14 * 2.5
dynTP3_short = close - atr14 * 4.0

// Static percentage TP
tp1L = close * (1 + tp1Pct / 100)
tp2L = close * (1 + tp2Pct / 100)
tp3L = close * (1 + tp3Pct / 100)
tp1S = close * (1 - tp1Pct / 100)
tp2S = close * (1 - tp2Pct / 100)
tp3S = close * (1 - tp3Pct / 100)

// EMA spread (ribbon width as % of price)
emaSpread = math.abs(emaFast - emaSlow) / close * 100
ema200dist = (close - ema200v) / ema200v * 100

plot(emaFast,       "emaFast")
plot(emaSlow,       "emaSlow")
plot(ema200v,       "ema200")
plot(emaTrendCross, "emaTrendCross", display=display.none)
plot(ema200dist,    "ema200dist",    display=display.none)
plot(dynSL_long,    "dynSL_long",    display=display.none)
plot(dynSL_short,   "dynSL_short",   display=display.none)
plot(dynTP1_long,   "dynTP1_long",   display=display.none)
plot(dynTP2_long,   "dynTP2_long",   display=display.none)
plot(dynTP3_long,   "dynTP3_long",   display=display.none)
plot(dynTP1_short,  "dynTP1_short",  display=display.none)
plot(dynTP2_short,  "dynTP2_short",  display=display.none)
plot(dynTP3_short,  "dynTP3_short",  display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 4) VOLUME (bsv, vp, order-flow)
// ─────────────────────────────────────────────────────────────────────────
bv = high == low ? 0.0 : volume * (close - low) / (high - low)
sv = high == low ? 0.0 : volume * (high - close) / (high - low)
maBuy  = ta.sma(bv, volMaLen)
maSell = ta.sma(sv, volMaLen)
buyPressure  = maBuy > maSell ? 1 : maBuy < maSell ? -1 : 0
deltaVol     = bv - sv
cumDelta     = ta.cum(deltaVol)
deltaMa      = ta.sma(deltaVol, volMaLen)

// Volume Profile
var float[] vc = array.new_float()
var float[] vv = array.new_float()
array.push(vc, close)
array.push(vv, volume)
if array.size(vc) > vpLookback
    array.shift(vc)
    array.shift(vv)
var float poc = na
var float vah = na
var float val = na
var float vpWidth = na
if array.size(vc) >= vpLookback
    pmin = array.min(vc)
    pmax = array.max(vc)
    binW = pmax > pmin ? (pmax - pmin) / vpBins : syminfo.mintick
    binVol = array.new_float(vpBins, 0.0)
    binCtr = array.new_float(vpBins, 0.0)
    for i = 0 to vpBins - 1
        binCtr.set(i, pmin + (i + 0.5) * binW)
    for i = 0 to array.size(vc) - 1
        p = array.get(vc, i)
        v = array.get(vv, i)
        idx = math.min(vpBins - 1, math.max(0, int((p - pmin) / binW)))
        binVol.set(idx, binVol.get(idx) + v)
    maxV = array.max(binVol)
    poc := binCtr.get(binVol.indexof(maxV))
    total = 0.0
    for i = 0 to vpBins - 1
        total += binVol.get(i)
    cum = 0.0
    val := na
    vah := na
    for i = 0 to vpBins - 1
        cum += binVol.get(i)
        if cum >= total * 0.15 and na(val)
            val := binCtr.get(i)
        if cum >= total * 0.85 and na(vah)
            vah := binCtr.get(i)
    vpWidth := na(vah) or na(val) ? na : (vah - val) / poc * 100

// Volume spike
volMAOF  = ta.sma(volume, volMaLenOF)
coinLine = ta.sma(close, coinMaLen)
volSpike = volume > volMAOF * volMultOF ? (close < coinLine ? -1 : 1) : 0
volRatio = volMAOF > 0 ? volume / volMAOF : 1.0

// OBV trend
obv     = ta.obv
obvSma  = ta.sma(obv, 20)
obvTrend = obv > obvSma ? 1 : obv < obvSma ? -1 : 0

plot(poc,          "poc")
plot(volSpike,     "volSpike",    display=display.none)
plot(volRatio,     "volRatio",    display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 5) LEVELS (sr-breaks)
// ─────────────────────────────────────────────────────────────────────────
pl = ta.pivotlow(leftB, rightB)
ph = ta.pivothigh(leftB, rightB)
support    = fixnan(pl)
resistance = fixnan(ph)

// Second layer S/R (half lookback)
pl2 = ta.pivotlow(math.max(1, int(leftB / 2)), math.max(1, int(rightB / 2)))
ph2 = ta.pivothigh(math.max(1, int(leftB / 2)), math.max(1, int(rightB / 2)))
support2    = fixnan(pl2)
resistance2 = fixnan(ph2)

// S/R break signals
srBreakUp = close > resistance[1] and close[1] <= resistance[1] ? 1 : 0
srBreakDn = close < support[1] and close[1] >= support[1] ? -1 : 0

plot(support,     "support")
plot(resistance,  "resistance")

// ─────────────────────────────────────────────────────────────────────────
// 6) OSCILLATOR / QUALITY
// ─────────────────────────────────────────────────────────────────────────
rsiV = ta.rsi(close, rsiLength)
lbR = 5
lbL = 5
rU = 60
rL = 5
plF = not na(ta.pivotlow(rsiV, lbL, lbR))
phF = not na(ta.pivothigh(rsiV, lbL, lbR))
inRange(c) =>
    bars = ta.barssince(c)
    rL <= bars and bars <= rU
rsiHL   = rsiV[lbR] > ta.valuewhen(plF, rsiV[lbR], 1) and inRange(plF[1])
priceLL = low[lbR] < ta.valuewhen(plF, low[lbR], 1)
bullDiv = priceLL and rsiHL and plF ? 1 : 0
rsiLH   = rsiV[lbR] < ta.valuewhen(phF, rsiV[lbR], 1) and inRange(phF[1])
priceHH = high[lbR] > ta.valuewhen(phF, high[lbR], 1)
bearDiv = priceHH and rsiLH and phF ? -1 : 0

// MACD divergence
[macdL, macdSig, macdHist] = ta.macd(close, macdFastLength, macdSlowLength, macdSignalLength)
macdBullDiv = ta.pivotlow(macdHist, 3, 3) ? (macdHist[3] > ta.valuewhen(not na(ta.pivotlow(macdHist, 3, 3)), macdHist[3], 1) and
              low[3] < ta.valuewhen(not na(ta.pivotlow(macdHist, 3, 3)), low[3], 1) ? 1 : 0) : 0
macdBearDiv = ta.pivothigh(macdHist, 3, 3) ? (macdHist[3] < ta.valuewhen(not na(ta.pivothigh(macdHist, 3, 3)), macdHist[3], 1) and
              high[3] > ta.valuewhen(not na(ta.pivothigh(macdHist, 3, 3)), high[3], 1) ? -1 : 0) : 0

// Combined divergence score
divScore = bullDiv + bearDiv + macdBullDiv + macdBearDiv

// Stochastic
stochK = ta.sma(ta.stoch(close, high, low, 14), 3)
stochD = ta.sma(stochK, 3)
stochCross = ta.crossover(stochK, stochD) and stochK < 20 ? 1 :
             ta.crossunder(stochK, stochD) and stochK > 80 ? -1 : 0

// HMA + SuperTrend confidence
hma = ta.hma(close, hmaLength)
[hmas, hdir] = ta.supertrend(stFactor, stAtr)
hmaUp   = hma > hma[1]
hmaDown = hma < hma[1]
kernel  = ta.sma(close, kernelPeriod)
distance = close - kernel
swH = ta.pivothigh(high, 5, 5)
swL = ta.pivotlow(low, 5, 5)
lastSH = fixnan(swH)
lastSL = fixnan(swL)
bosB   = close > lastSH
bosS   = close < lastSL
score  = 0
score += (hmaUp and hdir == -1) or (hmaDown and hdir == 1) ? 20 : 0
score += kernel > kernel[1] ? 20 : 0
score += math.abs(distance) > atr14 * 0.5 ? 20 : 0
score += bosB or bosS ? 20 : 0
score += (hmaUp and hdir == -1) ? 10 : 0
score := math.min(score, 100)
confidence = score

// TQI
erDenom = math.sum(math.abs(close - close[1]), erLen)
er      = na(erDenom) or erDenom == 0 ? na : math.abs(close - close[erLen]) / erDenom
volNorm = 1 - math.min(1.0, atr / (ta.atr(100) + syminfo.mintick))
structC = close > ta.sma(close, dviMomLen) ? 1.0 : 0.0
momC    = ta.roc(close, dviMomLen) > 0 ? 1.0 : 0.0
tqi     = math.max(0.0, math.min(1.0, 0.35 * nz(er) + 0.20 * volNorm + 0.25 * structC + 0.20 * momC))

// DVI
mom       = ta.roc(close, dviMomLen)
smaC      = ta.sma(close, dviMomLen)
dviTrend  = mom > 0 and close > smaC ? 1 : mom < 0 and close < smaC ? -1 : 0
rocV      = mom

// RSI zones
rsiZone = rsiV > 70 ? 2 : rsiV > 60 ? 1 : rsiV < 30 ? -2 : rsiV < 40 ? -1 : 0

plot(rsiV,         "rsi",         display=display.none)
plot(divScore,     "divScore",    display=display.none)
plot(confidence,   "confidence",  display=display.none)
plot(tqi,          "tqi",         display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 7) LIQUIDITY TRIGGER (liq-sweep)
// ─────────────────────────────────────────────────────────────────────────
hh = ta.highest(high[1], sweepLookback)
ll = ta.lowest(low[1], sweepLookback)
avgVol = ta.sma(volume, 20)
isHV = volume > avgVol * sweepMult
bullSweep = low < ll and close > ll and isHV ? 1 : 0
bearSweep = high > hh and close < hh and isHV ? -1 : 0
liqSweep  = bullSweep + bearSweep

// Sweep strength (how far past the level)
sweepDepth = bullSweep == 1 ? (ll - low) / atr14 :
             bearSweep == -1 ? (high - hh) / atr14 : 0.0

plot(liqSweep,   "liqSweep",   display=display.none)
plot(sweepDepth, "sweepDepth", display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 8) ICHIMOKU (numeric extraction)
// ─────────────────────────────────────────────────────────────────────────
donchian(len) =>
    math.avg(ta.lowest(len), ta.highest(len))
ichiConv    = donchian(ichiConvLen)
ichiBase    = donchian(ichiBaseLen)
ichiSpanA   = math.avg(ichiConv, ichiBase)
ichiSpanB   = donchian(ichiSpanLen)
ichiCloudTop    = math.max(ichiSpanA[ichiBaseLen], ichiSpanB[ichiBaseLen])
ichiCloudBottom = math.min(ichiSpanA[ichiBaseLen], ichiSpanB[ichiBaseLen])
ichiCloudWidth  = (ichiCloudTop - ichiCloudBottom) / close * 100

// Ichimoku signal: above cloud + conv > base = bullish
ichiSignal = close > ichiCloudTop and ichiConv > ichiBase ? 1 :
             close < ichiCloudBottom and ichiConv < ichiBase ? -1 : 0
// TK cross
tkCross = ta.crossover(ichiConv, ichiBase) ? 1 :
          ta.crossunder(ichiConv, ichiBase) ? -1 : 0
// Chikou (lagging span) — close vs close[baseLen]
chikouBull = close > close[ichiBaseLen] ? 1 : close < close[ichiBaseLen] ? -1 : 0

plot(ichiSignal,      "ichiSignal",      display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 9) ORDER BLOCKS (numeric)
// ─────────────────────────────────────────────────────────────────────────
// Bullish OB: last down candle before an impulse up
// Bearish OB: last up candle before an impulse down
impulseUp   = close > open and (close - open) > atr14 * 1.5
impulseDown = open > close and (open - close) > atr14 * 1.5

var float obBullHigh = na
var float obBullLow  = na
var float obBearHigh = na
var float obBearLow  = na
var int   obBullAge  = 0
var int   obBearAge  = 0

if impulseUp and close[1] < open[1]
    obBullHigh := high[1]
    obBullLow  := low[1]
    obBullAge  := 0
else
    obBullAge += 1

if impulseDown and close[1] > open[1]
    obBearHigh := high[1]
    obBearLow  := low[1]
    obBearAge  := 0
else
    obBearAge += 1

// Proximity: is price near an OB?
obBullProx = (not na(obBullHigh) and low <= obBullHigh and close >= obBullLow and obBullAge <= obLookback) ? 1 : 0
obBearProx = (not na(obBearHigh) and high >= obBearLow and close <= obBearHigh and obBearAge <= obLookback) ? -1 : 0
obSignal   = obBullProx + obBearProx

plot(nz(obBullHigh), "obBullHigh", display=display.none)
plot(nz(obBullLow),  "obBullLow",  display=display.none)
plot(nz(obBearHigh), "obBearHigh", display=display.none)
plot(nz(obBearLow),  "obBearLow",  display=display.none)
plot(obSignal,       "obSignal",   display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 10) FAIR VALUE GAPS (numeric)
// ─────────────────────────────────────────────────────────────────────────
// Bullish FVG: low[0] > high[2] (gap up)
// Bearish FVG: high[0] < low[2] (gap down)
fvgBullGap = low > high[2] and (low - high[2]) > atr14 * fvgMinATR ? low - high[2] : 0.0
fvgBearGap = high < low[2] and (low[2] - high) > atr14 * fvgMinATR ? low[2] - high : 0.0

var float fvgBullTop    = na
var float fvgBullBottom = na
var float fvgBearTop    = na
var float fvgBearBottom = na
var int   fvgBullAge    = 999
var int   fvgBearAge    = 999

if fvgBullGap > 0
    fvgBullTop    := low
    fvgBullBottom := high[2]
    fvgBullAge    := 0
else
    fvgBullAge += 1

if fvgBearGap > 0
    fvgBearTop    := low[2]
    fvgBearBottom := high
    fvgBearAge    := 0
else
    fvgBearAge += 1

// Is price filling an FVG?
fvgBullFill = not na(fvgBullTop) and close <= fvgBullTop and close >= fvgBullBottom and fvgBullAge <= obLookback ? 1 : 0
fvgBearFill = not na(fvgBearTop) and close >= fvgBearBottom and close <= fvgBearTop and fvgBearAge <= obLookback ? -1 : 0
fvgSignal   = fvgBullFill + fvgBearFill

plot(nz(fvgBullTop),    "fvgBullTop",    display=display.none)
plot(nz(fvgBullBottom), "fvgBullBottom", display=display.none)
plot(nz(fvgBearTop),    "fvgBearTop",    display=display.none)
plot(nz(fvgBearBottom), "fvgBearBottom", display=display.none)
plot(fvgSignal,         "fvgSignal",     display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 11) REGIME CLASSIFIER
// ─────────────────────────────────────────────────────────────────────────
// Regime based on efficiency ratio + ATR percentile
atrPercentile = ta.percentrank(atr14, regimeLen)
erRegime = nz(er)
// 1=trending, 0=ranging, -1=volatile/choppy
regime = erRegime > 0.6 ? 1 : atrPercentile > 80 ? -1 : 0
regimeLabel = erRegime > 0.6 ? 2 : erRegime > 0.4 ? 1 : erRegime > 0.2 ? 0 : -1
// Squeeze: BB inside Keltner
[bbMid, bbUp, bbLow] = ta.bb(close, keltLen, 2.0)
keltMa = ta.ema(close, keltLen)
keltATR = ta.atr(keltLen)
keltUp = keltMa + keltATR * keltMult
keltDn = keltMa - keltATR * keltMult
squeeze = bbUp < keltUp and bbLow > keltDn ? 1 : 0

plot(regimeLabel,   "regimeLabel",   display=display.none)
plot(squeeze,       "squeeze",       display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 12) SESSION DETECTION
// ─────────────────────────────────────────────────────────────────────────
hourNow = hour(time, "UTC")
isAsia   = hourNow >= asiaStart and hourNow < asiaEnd ? 1 : 0
isLondon = hourNow >= londonStart and hourNow < londonEnd ? 1 : 0
isNY     = hourNow >= nyStart and hourNow < nyEnd ? 1 : 0
isOverlap = isLondon == 1 and isNY == 1 ? 1 : 0
sessionCode = isOverlap == 1 ? 4 : isNY == 1 ? 3 : isLondon == 1 ? 2 : isAsia == 1 ? 1 : 0

plot(sessionCode, "sessionCode", display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 13) CANDLE PATTERN SCORING
// ─────────────────────────────────────────────────────────────────────────
bodySize   = math.abs(close - open)
upperWick  = high - math.max(close, open)
lowerWick  = math.min(close, open) - low
totalRange = high - low

// Hammer / Shooting Star
hammer      = lowerWick > bodySize * 2 and upperWick < bodySize * 0.5 and totalRange > atr14 * 0.5 ? 1 : 0
shootStar   = upperWick > bodySize * 2 and lowerWick < bodySize * 0.5 and totalRange > atr14 * 0.5 ? -1 : 0
// Engulfing
bullEngulf  = close > open and close[1] < open[1] and close > open[1] and open < close[1] ? 1 : 0
bearEngulf  = close < open and close[1] > open[1] and close < open[1] and open > close[1] ? -1 : 0
// Doji
doji        = bodySize < totalRange * 0.1 and totalRange > atr14 * 0.3 ? 1 : 0
// Pin bar
pinBull     = lowerWick > totalRange * 0.6 and close > open ? 1 : 0
pinBear     = upperWick > totalRange * 0.6 and close < open ? -1 : 0

candleScore = hammer + shootStar + bullEngulf + bearEngulf + pinBull + pinBear

plot(candleScore, "candleScore", display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 14) KELTNER CHANNEL
// ─────────────────────────────────────────────────────────────────────────
keltPosition = close > keltUp ? 1 : close < keltDn ? -1 : 0
keltWidth    = (keltUp - keltDn) / keltMa * 100


// ─────────────────────────────────────────────────────────────────────────
// 15) VWAP
// ─────────────────────────────────────────────────────────────────────────
vwapVal    = ta.vwap(close)
vwapDist   = (close - vwapVal) / vwapVal * 100
vwapSignal = close > vwapVal ? 1 : close < vwapVal ? -1 : 0


// ─────────────────────────────────────────────────────────────────────────
// 16) ENTRY TIMING SCORE (micro-structure)
// ─────────────────────────────────────────────────────────────────────────
// Combines: candle pattern, stoch cross, volume spike, proximity to S/R/OB/FVG
entryTiming = 0.0
entryTiming += math.abs(candleScore) > 0 ? 20 : 0
entryTiming += stochCross != 0 ? 20 : 0
entryTiming += volSpike != 0 ? 15 : 0
entryTiming += obSignal != 0 ? 15 : 0
entryTiming += fvgSignal != 0 ? 10 : 0
entryTiming += math.abs(vwapDist) < 0.3 ? 10 : 0
// Bonus if near support/resistance
nearSR = (not na(support) and math.abs(close - support) / atr14 < 1.5) or
         (not na(resistance) and math.abs(close - resistance) / atr14 < 1.5)
entryTiming += nearSR ? 10 : 0
entryTiming := math.min(entryTiming, 100)

plot(entryTiming, "entryTiming", display=display.none)

// ─────────────────────────────────────────────────────────────────────────
// 17) COMPOSITE SIGNAL (v2 with decay + weights)
// ─────────────────────────────────────────────────────────────────────────
totalWeight = compWeightBias + compWeightTrend + compWeightST + compWeightConf +
              compWeightTQI + compWeightDiv + compWeightLiq + compWeightVol +
              compWeightOB + compWeightFVG + compWeightIchi

scalpRaw = 0.0
scalpRaw += biasWeighted * compWeightBias
scalpRaw += emaTrend * compWeightTrend
scalpRaw += stTrend * compWeightST
scalpRaw += (confidence - 50) / 50 * compWeightConf
scalpRaw += (tqi - 0.5) * 2 * compWeightTQI
scalpRaw += divScore * compWeightDiv
scalpRaw += liqSweep * compWeightLiq
scalpRaw += volSpike * compWeightVol
scalpRaw += obSignal * compWeightOB
scalpRaw += fvgSignal * compWeightFVG
scalpRaw += ichiSignal * compWeightIchi

// Normalize to -100..100
scalpScore = totalWeight > 0 ? math.max(-100.0, math.min(100.0, scalpRaw / totalWeight * 100)) : 0.0

// Decay: smooth score over N bars to reduce whipsaws
scalpSmooth = ta.ema(scalpScore, decayBars)

// Signal thresholds
scalpSignal = scalpSmooth > 30 ? 1 : scalpSmooth < -30 ? -1 : 0
scalpStrong = scalpSmooth > 60 ? 1 : scalpSmooth < -60 ? -1 : 0

// Signal persistence: bars since last signal
var int barsSinceBuy  = 9999
var int barsSinceSell = 9999
if scalpSignal == 1
    barsSinceBuy := 0
else
    barsSinceBuy += 1
if scalpSignal == -1
    barsSinceSell := 0
else
    barsSinceSell += 1

// Trend agreement count
trendAgree = 0
trendAgree += emaTrend > 0 ? 1 : emaTrend < 0 ? -1 : 0
trendAgree += stTrend > 0 ? 1 : stTrend < 0 ? -1 : 0
trendAgree += ichiSignal > 0 ? 1 : ichiSignal < 0 ? -1 : 0
trendAgree += vwapSignal > 0 ? 1 : vwapSignal < 0 ? -1 : 0
trendAgree += dviTrend > 0 ? 1 : dviTrend < 0 ? -1 : 0

// Risk/reward estimates
rrLong  = dynSL_long > 0 ? (dynTP2_long - close) / (close - dynSL_long) : 0
rrShort = dynSL_short > 0 ? (close - dynTP2_short) / (dynSL_short - close) : 0

plot(scalpScore,    "scalpScore",    display=display.none)
plot(scalpSmooth,   "scalpSmooth",   display=display.none)
plot(scalpSignal,   "scalpSignal",   display=display.none)
plot(scalpStrong,   "scalpStrong",   display=display.none)
plot(trendAgree,    "trendAgree",    display=display.none)
plot(rrLong,        "rrLong",        display=display.none)
plot(rrShort,       "rrShort",       display=display.none)

