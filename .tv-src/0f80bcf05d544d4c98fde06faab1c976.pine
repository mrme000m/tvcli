// 1. INDICATOR DECLARATION
// ══════════════════════════════════════════════════════════
indicator(
     title              = "Self-Aware Trend System [WillyAlgoTrader]",
     shorttitle         = "SATS",
     overlay            = true,
     max_lines_count    = 500,
     max_labels_count   = 500,
     max_boxes_count    = 100,
     max_bars_back      = 5000)

