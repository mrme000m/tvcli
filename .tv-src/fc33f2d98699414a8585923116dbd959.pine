//@version=6
indicator("Ultra Sensitive SuperTrend v6  HEIKEN + 2x + ALERT", overlay=true, max_labels_count=500)

// ————— INPUTS —————
atrPeriod1     = input.int(10, "1st SuperTrend ATR Period", minval=1)
multiplier1    = input.float(1.0, "1st SuperTrend Multiplier (Sensitive)", minval=0.1, step=0.1)
atrPeriod2     = input.int(5,  "2nd SuperTrend ATR Period (Ultra Sensitive)", minval=1)
multiplier2    = input.float(0.5, "2nd SuperTrend Multiplier (Ultra)", minval=0.1, step=0.1)
useHeikenAshi  = input.bool(true, "Use Heiken-Ashi Filter")
showLabels     = input.bool(true, "Show Labels")
showBG         = input.bool(true, "Background Color")

// ————— HEIKEN-ASHI —————
ha_close = (open + high + low + close) / 4
var float ha_open = na
ha_open := na(ha_open[1]) ? (open + close) / 2 : (ha_open[1] + ha_close[1]) / 2
ha_high  = math.max(high, math.max(ha_open, ha_close))
ha_low   = math.min(low,  math.min(ha_open, ha_close))
price_src = useHeikenAshi ? ha_close : close

// ————— 1st SUPER TREND (SENSITIVE) —————
atr1 = ta.atr(atrPeriod1)
hl2_1 = (high + low) / 2
upperBand1 = hl2_1 + atr1 * multiplier1
lowerBand1 = hl2_1 - atr1 * multiplier1
var float finalUpper1 = na
var float finalLower1 = na
var int   trend1      = 1
finalUpper1 := (upperBand1 < nz(finalUpper1[1]) or close[1] > nz(finalUpper1[1])) ? upperBand1 : nz(finalUpper1[1])
finalLower1 := (lowerBand1 > nz(finalLower1[1]) or close[1] < nz(finalLower1[1])) ? lowerBand1 : nz(finalLower1[1])
trend1 := close > finalUpper1[1] ? 1 : close < finalLower1[1] ? -1 : nz(trend1[1])
supertrend1 = trend1 == 1 ? finalLower1 : finalUpper1

// ————— 2nd SUPER TREND (ULTRA SENSITIVE) —————
atr2 = ta.atr(atrPeriod2)
hl2_2 = (high + low) / 2
upperBand2 = hl2_2 + atr2 * multiplier2
lowerBand2 = hl2_2 - atr2 * multiplier2
var float finalUpper2 = na
var float finalLower2 = na
var int   trend2      = 1
finalUpper2 := (upperBand2 < nz(finalUpper2[1]) or close[1] > nz(finalUpper2[1])) ? upperBand2 : nz(finalUpper2[1])
finalLower2 := (lowerBand2 > nz(finalLower2[1]) or close[1] < nz(finalLower2[1])) ? lowerBand2 : nz(finalLower2[1])
trend2 := close > finalUpper2[1] ? 1 : close < finalLower2[1] ? -1 : nz(trend2[1])
supertrend2 = trend2 == 1 ? finalLower2 : finalUpper2

// ————— COMBINED SIGNAL —————
buySignal  = ta.crossover(price_src, supertrend1) and nz(trend2) == 1
sellSignal = ta.crossunder(price_src, supertrend1) and nz(trend2) == -1

// ————— PLOT —————
plot(supertrend1, "ST1", color = trend1 == 1 ? color.green : color.red, linewidth = 2)
plot(supertrend2, "ST2", color = trend2 == 1 ? color.lime : color.maroon, linewidth = 1, style = plot.style_circles)
bgcolor(showBG ? (trend1 == 1 ? color.new(color.green, 90) : color.new(color.red, 90)) : na)

// ————— LABELS —————
if showLabels and buySignal
    label.new(bar_index, low, "BUY", xloc = xloc.bar_index, color = color.green, style = label.style_label_up, textcolor = color.white, size = size.small)
if showLabels and sellSignal
    label.new(bar_index, high, "SELL", xloc = xloc.bar_index, color = color.red, style = label.style_label_down, textcolor = color.white, size = size.small)

// ————— TRIANGLES —————
plotshape(buySignal,  title="BUY",  location=location.belowbar, color=color.green, style=shape.triangleup,   size=size.small)
plotshape(sellSignal, title="SELL", location=location.abovebar, color=color.red,   style=shape.triangledown, size=size.small)

// ————— ALERTS —————
alertcondition(buySignal,  title="ULTRA BUY",  message="ULTRA BUY: {{ticker}} @ {{close}}")
alertcondition(sellSignal, title="ULTRA SELL", message="ULTRA SELL: {{ticker}} @ {{close}}")