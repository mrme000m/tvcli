//@version=6
indicator("Fixed Range Volume Profile Zones (with Dynamic Percentile Buffers)", overlay=false, max_bars_back=5000)

// === INPUTS ===
lookback_days = input.int(30, "Lookback Days", minval=1)

num_bins = input.int(30, 
     "Number of Bins", 
     minval=5, 
     tooltip="Controls the resolution of the volume profile. Higher values give finer detail, but may be more sensitive to noise."
     )

percentile_upper = input.float(95.0, "VAH Percentile", minval=50.0, maxval=100.0, step=0.1, 
     tooltip="Upper percentile used to calculate buffer above VAH (e.g. 90 = 90th percentile of recent prices)")
percentile_lower = input.float(5.0, "VAL Percentile", minval=0.0, maxval=50.0, step=0.1, 
     tooltip="Lower percentile used to calculate buffer below VAL (e.g. 10 = 10th percentile of recent prices)")

// === GLOBAL VARIABLES ===
var float VAL = na
var float VAH = na
var float POC = na

// === ACCUMULATE CLOSE & VOLUME ===
var float[] closes = array.new_float()
var float[] vols   = array.new_float()

if barstate.isfirst
    array.clear(closes)
    array.clear(vols)

array.push(closes, close)
array.push(vols, volume)

if array.size(closes) > lookback_days
    array.shift(closes)
    array.shift(vols)

if array.size(closes) >= lookback_days
    // === BINNING SETUP ===
    float pmin = array.min(closes)
    float pmax = array.max(closes)
    float prange = pmax - pmin
    float bin_width = prange > 0 ? prange / num_bins : 1.0

    float[] bin_vol = array.new_float(num_bins, 0.0)
    float[] bin_center = array.new_float(num_bins, 0.0)

    for i = 0 to num_bins - 1
        float left = pmin + i * bin_width
        float right = left + bin_width
        array.set(bin_center, i, (left + right) / 2)

    for i = 0 to array.size(closes) - 1
        float price = array.get(closes, i)
        float vol = array.get(vols, i)
        int bin_index = math.min(num_bins - 1, math.max(0, math.floor((price - pmin) / bin_width)))
        array.set(bin_vol, bin_index, array.get(bin_vol, bin_index) + vol)

    // === FILTER NON-ZERO BINS ===
    float[] nz_center = array.new_float()
    float[] nz_vol = array.new_float()
    for i = 0 to num_bins - 1
        float v = array.get(bin_vol, i)
        if v > 0
            array.push(nz_center, array.get(bin_center, i))
            array.push(nz_vol, v)

    if array.size(nz_center) >= 3
        int nz = array.size(nz_center)
        int[] idx = array.new_int(nz)
        for i = 0 to nz - 1
            array.set(idx, i, i)

        // Selection sort idx based on nz_center values
        for i = 0 to nz - 2
            int min_idx = i
            for j = i + 1 to nz - 1
                if array.get(nz_center, array.get(idx, j)) < array.get(nz_center, array.get(idx, min_idx))
                    min_idx := j
            if i != min_idx
                int tmp = array.get(idx, i)
                array.set(idx, i, array.get(idx, min_idx))
                array.set(idx, min_idx, tmp)

        int zone_size = math.ceil(nz / 3)
        float max_vol = -1.0

        for j = 0 to nz - 1
            int bin_i = array.get(idx, j)
            float center = array.get(nz_center, bin_i)
            float vol = array.get(nz_vol, bin_i)
            int zone = j / zone_size
            if zone > 2
                zone := 2
            if zone == 0
                VAL := center
            if zone == 2
                VAH := center
            if zone == 1 and vol > max_vol
                max_vol := vol
                POC := center

// === DYNAMIC PERCENTILE BUFFERS ===
// Clone and sort close array
float[] sorted_close = array.copy(closes)
array.sort(sorted_close, order.ascending)

int n = array.size(sorted_close)
int idx_90 = math.max(0, math.min(math.round(n * percentile_upper / 100) - 1, n - 1))
int idx_10 = math.max(0, math.min(math.round(n * percentile_lower / 100) - 1, n - 1))

float price_pct_90 = array.get(sorted_close, idx_90)
float price_pct_10 = array.get(sorted_close, idx_10)

float VAH_BUF = price_pct_90 - VAH
float VAL_BUF = VAL - price_pct_10

// === PLOT ZONES ===
plot_val = plot(VAL, "VAL", color=color.green, style=plot.style_line, linewidth=1)
plot_vah = plot(VAH, "VAH", color=color.orange, style=plot.style_line, linewidth=1)
plot_poc = plot(POC, "POC", color=color.red, style=plot.style_line, linewidth=2)

// === SHADED BUY / SELL ZONES ===
plot_pmin = plot(array.size(closes) >= lookback_days ? array.min(closes) : na, title="Min Price", color=color.new(color.green, 100))
plot_pmax = plot(array.size(closes) >= lookback_days ? array.max(closes) : na, title="Max Price", color=color.new(color.red, 100))

fill(plot_val, plot_pmin, color=color.new(color.green, 90))
fill(plot_vah, plot_pmax, color=color.new(color.red, 90))

plotcandle(open, high, low, close, "Price Action", close[2] < close[1] ? color.aqua : close[2] > close[1] ? color.fuchsia : color.new(color.black, 100), color.white)

// === SIGNAL ARROWS WITH DYNAMIC BUFFERS ===
plotshape(
     series = close > VAH + VAH_BUF and not na(VAH),
     title = "Above VAH + Buffer",
     location = location.abovebar,
     color = color.red,
     style = shape.triangledown,
     size = size.tiny
     )

plotshape(
     series = close < VAL - VAL_BUF and not na(VAL),
     title = "Below VAL - Buffer",
     location = location.belowbar,
     color = color.green,
     style = shape.triangleup,
     size = size.tiny
     )
